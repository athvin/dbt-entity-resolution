# Build artefacts. 3.54: .gitignore alone loses to `git add -f`, so a pre-commit
# hook rejects these when staged. Both halves are required; neither is enough.
target/
dbt_packages/
logs/
.venv/
*.duckdb
*.duckdb.wal
.duckdb_tmp/
.observability/

# The parquet the harness reads (B.1 / DR-13). Regenerated by every build;
# committing it would give the comparator a stale left-hand side.
exports/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
